---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

const heroHeadline = home?.heroHeadline || 'Community · Care · Connect';
const heroSubline = home?.heroSubline || 'We provide customized property management services to elevate the value and efficiency of your community.';
const heroCta = home?.heroCta || 'Get Started';
const heroPortalLabel = home?.heroPortalLabel || 'Homeowner Portal';

const whyHeadline = home?.whyHeadline || 'Why 3c HOA Management?';
const whyBody = home?.whyBody || 'With over 10 years of community association management experience, we combine industry expertise with genuine care for every community we serve. We believe in transparent, proactive management that keeps boards informed and homeowners engaged.';
const whyBullets = home?.whyBullets?.length ? home.whyBullets : [
  'Transparent communication with boards and homeowners',
  'Proactive maintenance and financial stewardship',
  'Community-specific, customized solutions',
  '10+ years of HOA management expertise',
];

const ctaHeadline = home?.ctaHeadline || 'Ready to elevate your community?';
const ctaSubline = home?.ctaSubline || "Let's talk about your community's unique needs.";

const testimonialsHeadline = home?.testimonialsHeadline || 'What our communities say';
const testimonialsSubline = home?.testimonialsSubline || 'Boards and homeowners on what it’s like to work with 3c.';
const testimonials = (home?.testimonials ?? []).filter((t) => t?.quote?.trim());

// The track holds two identical groups and slides exactly one group width, so the
// loop is seamless. Repeat short lists first so the strip is always wider than the screen.
const repeats = testimonials.length ? Math.max(1, Math.ceil(4 / testimonials.length)) : 0;
const marqueeGroup = Array.from({ length: repeats }, () => testimonials).flat();
const marqueeSeconds = marqueeGroup.length * 12;
---

<Layout
  title="3c HOA Management — Community · Care · Connect"
  description="3c HOA Management provides customized property management services in Utah — HOA management, accounting, owner representation, and insurance claims assistance."
>
  <Header />

  {/* Hero */}
  <section class="relative flex min-h-[600px] items-center justify-center overflow-hidden sm:min-h-[700px]">
    <img
      src="/images/hero-banner.jpg"
      alt="Park City Main Street at sunset"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-nav/70"></div>
    <div class="hero-rise relative z-10 mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white backdrop-blur-sm">
        3c HOA Management Co.
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
        {heroHeadline}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-white/80">
        {heroSubline}
      </p>
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact" class="rounded-lg bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
          {heroCta}
        </a>
        <a href="https://app.allhoa.com/go/3c" target="_blank" rel="noreferrer" class="rounded-lg border border-white/30 bg-white/10 px-8 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/20">
          {heroPortalLabel}
        </a>
      </div>
    </div>
  </section>

  {/* Services overview */}
  <section class="bg-secondary py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Our Services</h2>
        <p class="mt-4 text-lg text-muted-foreground">Comprehensive HOA management tailored to your community.</p>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/><path d="m9 14 2.25 2.25L15.5 12"/>', title: 'Property Management', desc: 'Board meetings, vendor coordination, compliance, and routine maintenance — we handle the day-to-day so your board can focus on the community.', href: '/services#property-management' },
          { icon: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m7 14 4-4 3 3 5-6"/>', title: 'Accounting', desc: 'Full-cycle financial management: budgeting, AP/AR, collections, reconciliation, and secure document storage via the Owner\'s Portal.', href: '/services#accounting' },
          { icon: '<path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1Z"/><path d="M10 10V5a2 2 0 0 1 4 0v5"/><path d="M4 15v-3a8 8 0 0 1 16 0v3"/>', title: "Owner's Representative", desc: 'Capital reserve project management — from stakeholder collaboration and fund oversight to scheduling and funding assistance.', href: '/services#owners-rep' },
          { icon: '<path d="M22 12a10.06 10.06 0 0 0-20 0Z"/><path d="M12 12v8a2 2 0 0 0 4 0"/><path d="M12 2v1"/>', title: 'Insurance Claims', desc: 'Expert guidance through the claims process and repair coordination, so your community gets the coverage it deserves.', href: '/services#insurance' },
          { icon: '<path d="M3 22h18"/><path d="M6 18v-7"/><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="m12 2 9 6H3Z"/>', title: 'Special Assessment & Loan Management', desc: 'Navigate major capital funding hurdles with specialized lender sourcing, assessment structuring, and multi-year tracking.', href: '/services#special-assessment' },
          { icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m4.93 19.07 4.24-4.24"/>', title: 'HOA Financial Rescue & Forensic Accounting', desc: 'Untangle chaotic or neglected books with forensic auditing, reconciliation catch-up, and compliant collections recovery.', href: '/services#forensic-accounting' },
          { icon: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>', title: 'Developer Transition & Handover', desc: 'Protect your community\'s interests during the critical handover from builder to board with independent audits and operational setup.', href: '/services#developer-transition' },
          { icon: '<path d="M11 12h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 14"/><path d="m7 18 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 13 6 6"/>', title: 'Self-Managed HOA Support', desc: 'Stay self-managed with professional-grade financials, an online payment portal, and organized records — plus expert help on the projects your volunteers shouldn\'t have to tackle alone.', href: '/services#self-managed' },
        ].map((svc) => (
          <a href={svc.href} class="group flex flex-col rounded-2xl border border-border bg-card p-8 shadow-[var(--shadow-soft)] transition-shadow hover:shadow-[var(--shadow-elevated)]">
            <div class="mb-4 text-gold">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-9 w-9" set:html={svc.icon} />
            </div>
            <h3 class="text-base font-semibold text-foreground group-hover:text-primary">{svc.title}</h3>
            <p class="mt-3 flex-1 text-sm text-muted-foreground">{svc.desc}</p>
            <span class="mt-6 text-sm font-medium text-primary">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Why 3c */}
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{whyHeadline}</h2>
          <p class="mt-6 text-lg text-muted-foreground">{whyBody}</p>
          <ul class="mt-8 space-y-4">
            {whyBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
          <a href="/about" class="mt-10 inline-flex rounded-lg border border-border px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
            Meet our team →
          </a>
        </div>
        <div class="overflow-hidden rounded-2xl">
          <img
            src="/images/hero-banner.jpg"
            alt="Park City community"
            class="h-80 w-full object-cover object-center lg:h-[440px]"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Homeowner Portal CTA */}
  <section class="bg-secondary py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Already a resident?</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground">
        Access your community documents, pay assessments, submit requests, and stay connected through your Homeowner Portal.
      </p>
      <a
        href="https://app.allhoa.com/go/3c"
        target="_blank"
        rel="noreferrer"
        class="mt-8 inline-flex rounded-lg bg-nav px-8 py-3.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Homeowner Portal Login →
      </a>
    </div>
  </section>

  {/* Testimonials */}
  {testimonials.length > 0 && (
    <section class="py-20 sm:py-28" aria-labelledby="testimonials-heading">
      <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
        <h2 id="testimonials-heading" class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{testimonialsHeadline}</h2>
        <p class="mt-4 text-lg text-muted-foreground">{testimonialsSubline}</p>
      </div>

      <div class="mt-14" data-marquee>
        <div class="marquee">
          <div class="marquee-track" style={`--marquee-duration: ${marqueeSeconds}s`}>
            {[0, 1].map((copy) => (
              <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                {marqueeGroup.map((t) => (
                  <figure class="marquee-card flex flex-col rounded-2xl border border-border bg-card p-8 shadow-[var(--shadow-soft)]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-8 w-8 text-gold" aria-hidden="true">
                      <path d="M9.5 5C6.46 5 4 7.46 4 10.5S6.46 16 9.5 16h.3c-.6 1.6-1.9 2.7-3.6 3.2l.6 1.8c3.6-1.1 6-4.3 6-8.5V10.5C12.8 7.46 10.9 5 9.5 5Zm9 0C15.46 5 13 7.46 13 10.5S15.46 16 18.5 16h.3c-.6 1.6-1.9 2.7-3.6 3.2l.6 1.8c3.6-1.1 6-4.3 6-8.5V10.5C21.8 7.46 19.9 5 18.5 5Z"/>
                    </svg>
                    <blockquote class="marquee-quote mt-5 text-base leading-relaxed text-muted-foreground">{t.quote}</blockquote>
                    {/* Unhidden by script only on cards whose quote is actually clipped */}
                    <button
                      type="button"
                      data-testimonial-more
                      hidden
                      tabindex={copy === 1 ? -1 : undefined}
                      class="mt-3 self-start text-sm font-semibold text-primary hover:underline"
                    >
                      Continue reading →
                    </button>
                    <figcaption class="mt-auto pt-6 text-sm font-semibold text-foreground">— {t.name}</figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>

        <div class="mt-10 flex justify-center">
          <button
            type="button"
            data-marquee-toggle
            class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="marquee-icon-pause h-4 w-4" aria-hidden="true">
              <rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" />
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="marquee-icon-play h-4 w-4" aria-hidden="true">
              <path d="M8 5.5a1 1 0 0 1 1.5-.87l9 6.5a1 1 0 0 1 0 1.74l-9 6.5A1 1 0 0 1 8 18.5Z" />
            </svg>
            <span class="marquee-label-pause">Pause testimonials</span>
            <span class="marquee-label-play">Play testimonials</span>
          </button>
        </div>
      </div>

      <dialog id="testimonial-dialog" aria-label="Full testimonial"
        class="m-auto w-[min(42rem,92vw)] rounded-2xl border border-border bg-card p-8 text-foreground backdrop:bg-black/50 sm:p-10">
        <blockquote id="testimonial-dialog-quote" class="max-h-[60vh] overflow-y-auto whitespace-pre-line text-base leading-relaxed text-muted-foreground"></blockquote>
        <p id="testimonial-dialog-name" class="mt-6 text-sm font-semibold text-foreground"></p>
        <button type="button" data-testimonial-close
          class="mt-8 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted">
          Close
        </button>
      </dialog>
    </section>
  )}

  {/* CTA */}
  <section class="bg-nav py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{ctaHeadline}</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/70">{ctaSubline}</p>
      <a href="/contact" class="mt-8 inline-flex rounded-lg bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        Contact us
      </a>
    </div>
  </section>

  <Footer />

  <script is:inline>
    document.querySelectorAll('[data-marquee]').forEach((marquee) => {
      const toggle = marquee.querySelector('[data-marquee-toggle]');
      if (!toggle) return;
      const setPaused = (paused) => {
        if (paused) marquee.setAttribute('data-paused', '');
        else marquee.removeAttribute('data-paused');
      };
      // Honour a reduced-motion preference by starting still; the button still works.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) setPaused(true);
      toggle.addEventListener('click', () => setPaused(!marquee.hasAttribute('data-paused')));
    });

    // Long quotes are clipped by CSS; only those actually clipped get "Continue reading".
    const quotes = document.querySelectorAll('.marquee-quote');

    const syncReadMore = () => {
      quotes.forEach((quote) => {
        const button = quote.parentElement?.querySelector('[data-testimonial-more]');
        if (!(button instanceof HTMLElement)) return;
        button.hidden = quote.scrollHeight <= quote.clientHeight + 1;
      });
    };

    if (quotes.length) {
      // Inter loads async, so measure again once it has swapped in.
      syncReadMore();
      document.fonts?.ready.then(syncReadMore);

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(syncReadMore, 150);
      });

      const dialog = document.getElementById('testimonial-dialog');
      const dialogQuote = document.getElementById('testimonial-dialog-quote');
      const dialogName = document.getElementById('testimonial-dialog-name');
      const marquee = document.querySelector('[data-marquee]');
      let wasPaused = false;

      document.querySelectorAll('[data-testimonial-more]').forEach((button) => {
        button.addEventListener('click', () => {
          const card = button.closest('figure');
          if (!dialog || !card) return;
          if (dialogQuote) dialogQuote.textContent = card.querySelector('blockquote')?.textContent ?? '';
          if (dialogName) dialogName.textContent = card.querySelector('figcaption')?.textContent ?? '';
          // Hold the strip still so the card is where they left it on close.
          wasPaused = !!marquee?.hasAttribute('data-paused');
          marquee?.setAttribute('data-paused', '');
          dialog.showModal();
        });
      });

      // Restore is driven from each close path rather than the dialog's own 'close'
      // event, which not every engine fires reliably. Idempotent, so double calls are fine.
      const restoreMarquee = () => {
        if (!wasPaused) marquee?.removeAttribute('data-paused');
      };
      const closeDialog = () => {
        dialog?.close();
        restoreMarquee();
      };

      dialog?.querySelector('[data-testimonial-close]')?.addEventListener('click', closeDialog);
      // Clicking the backdrop closes too.
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
      // Escape closes natively; just catch up on the marquee state.
      dialog?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') restoreMarquee();
      });
      dialog?.addEventListener('close', restoreMarquee);
    }
  </script>
</Layout>
