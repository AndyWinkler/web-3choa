---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

const heroHeadline = home?.heroHeadline ?? 'Community · Care · Connect';
const heroSubline = home?.heroSubline ?? 'We provide customized property management services to elevate the value and efficiency of your community.';
const heroCta = home?.heroCta ?? 'Get Started';
const heroPortalLabel = home?.heroPortalLabel ?? 'Homeowner Portal';

const whyHeadline = home?.whyHeadline ?? 'Why 3c HOA Management?';
const whyBody = home?.whyBody ?? 'With over 10 years of community association management experience, we combine industry expertise with genuine care for every community we serve. We believe in transparent, proactive management that keeps boards informed and homeowners engaged.';

const ctaHeadline = home?.ctaHeadline ?? 'Ready to elevate your community?';
const ctaSubline = home?.ctaSubline ?? "Let's talk about your community's unique needs.";
---

<Layout
  title="3c HOA Management — Community · Care · Connect"
  description="3c HOA Management provides customized property management services in Utah — HOA management, accounting, owner representation, and insurance claims assistance."
>
  <Header />

  {/* Hero */}
  <section class="relative flex min-h-[600px] items-center justify-center overflow-hidden sm:min-h-[700px]">
    <img
      src="/images/hero-banner.jpg"
      alt="Park City Main Street at sunset"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-nav/70"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white backdrop-blur-sm">
        3c HOA Management Co.
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
        {heroHeadline}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-white/80">
        {heroSubline}
      </p>
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact" class="rounded-lg bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
          {heroCta}
        </a>
        <a href="https://app.buildinglink.com" target="_blank" rel="noreferrer" class="rounded-lg border border-white/30 bg-white/10 px-8 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/20">
          {heroPortalLabel}
        </a>
      </div>
    </div>
  </section>

  {/* Services overview */}
  <section class="bg-secondary py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Our Services</h2>
        <p class="mt-4 text-lg text-muted-foreground">Comprehensive HOA management tailored to your community.</p>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: '🏘️', title: 'Property Management', desc: 'Board meetings, vendor coordination, compliance, and routine maintenance — we handle the day-to-day so your board can focus on the community.', href: '/services#property-management' },
          { icon: '📊', title: 'Accounting', desc: 'Full-cycle financial management: budgeting, AP/AR, collections, reconciliation, and secure document storage via the Owner\'s Portal.', href: '/services#accounting' },
          { icon: '🤝', title: "Owner's Representative", desc: 'Capital reserve project management — from stakeholder collaboration and fund oversight to scheduling and funding assistance.', href: '/services#owners-rep' },
          { icon: '🛡️', title: 'Insurance Claims', desc: 'Expert guidance through the claims process and repair coordination, so your community gets the coverage it deserves.', href: '/services#insurance' },
        ].map((svc) => (
          <a href={svc.href} class="group flex flex-col rounded-2xl border border-border bg-card p-8 shadow-[var(--shadow-soft)] transition-shadow hover:shadow-[var(--shadow-elevated)]">
            <div class="mb-4 text-3xl">{svc.icon}</div>
            <h3 class="text-base font-semibold text-foreground group-hover:text-primary">{svc.title}</h3>
            <p class="mt-3 flex-1 text-sm text-muted-foreground">{svc.desc}</p>
            <span class="mt-6 text-sm font-medium text-primary">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Why 3c */}
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{whyHeadline}</h2>
          <p class="mt-6 text-lg text-muted-foreground">{whyBody}</p>
          <ul class="mt-8 space-y-4">
            {[
              'Transparent communication with boards and homeowners',
              'Proactive maintenance and financial stewardship',
              'Community-specific, customized solutions',
              '10+ years of HOA management expertise',
            ].map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
          <a href="/about" class="mt-10 inline-flex rounded-lg border border-border px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
            Meet our team →
          </a>
        </div>
        <div class="overflow-hidden rounded-2xl">
          <img
            src="/images/hero-banner.jpg"
            alt="Park City community"
            class="h-80 w-full object-cover object-center lg:h-[440px]"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Homeowner Portal CTA */}
  <section class="bg-secondary py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Already a resident?</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground">
        Access your community documents, pay assessments, submit requests, and stay connected through your Homeowner Portal.
      </p>
      <a
        href="https://app.buildinglink.com"
        target="_blank"
        rel="noreferrer"
        class="mt-8 inline-flex rounded-lg bg-nav px-8 py-3.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Homeowner Portal Login →
      </a>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-nav py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{ctaHeadline}</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/70">{ctaSubline}</p>
      <a href="/contact" class="mt-8 inline-flex rounded-lg bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        Contact us
      </a>
    </div>
  </section>

  <Footer />
</Layout>
