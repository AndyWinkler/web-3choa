---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
---

<Layout
  title="Privacy Policy — 3c HOA Management"
  description="3c HOA Management privacy policy — how we collect, use, and protect your information."
>
  <Header />

  <PageHero headline="Privacy Policy" align="left">
    <p class="mt-4 text-sm text-white/80">Last updated: June 2025</p>
  </PageHero>

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 prose prose-slate max-w-none">
      <div class="space-y-8 text-sm text-muted-foreground leading-relaxed">

        <div>
          <h2 class="text-lg font-semibold text-foreground">Information We Collect</h2>
          <p class="mt-3">When you submit a contact form on this website, we collect your name, email address, and the content of your message. We may also collect your community or HOA name and a topic category if provided. We do not collect payment information through this website.</p>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-foreground">How We Use Your Information</h2>
          <p class="mt-3">We use the information you provide solely to respond to your inquiry and communicate with you about our services. We do not sell, rent, or share your personal information with third parties for marketing purposes.</p>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-foreground">SMS Communications</h2>
          <p class="mt-3">By submitting a contact form, you may consent to receive SMS communications from 3c HOA Management related to your inquiry. Message and data rates may apply. You may opt out at any time by replying STOP.</p>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-foreground">Data Storage</h2>
          <p class="mt-3">Contact form submissions are stored securely and retained only as long as necessary to respond to your inquiry or as required by applicable law.</p>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-foreground">Cookies</h2>
          <p class="mt-3">This website does not use tracking cookies or third-party analytics services.</p>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-foreground">Contact</h2>
          <p class="mt-3">If you have questions about this privacy policy, please contact us via the <a href="/contact" class="text-primary hover:underline">contact form</a> or by calling (435) 250-4150.</p>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-foreground">Changes to This Policy</h2>
          <p class="mt-3">We may update this privacy policy from time to time. Changes will be posted on this page with an updated date.</p>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
