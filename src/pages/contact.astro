---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const site = await reader.singletons.site.read();

const contactHeadline = site?.contactHeroHeadline ?? "Let's talk.";
const contactSubline = site?.contactHeroSubline ?? "Questions about your community, our services, or getting started? Send us a note and we'll respond within one business day.";
const successHeading = site?.contactSuccessHeading ?? 'Message received';
const successBody = site?.contactSuccessBody ?? "We'll be in touch within one business day. Thank you!";

// `||` rather than `??`: the Keystatic reader hands back '' for a key that is absent from
// the YAML or cleared in the CMS, and these cards should never render blank.
const phoneCardTitle = site?.contactPhoneCardTitle || 'Phone';
const phoneNumber = site?.contactPhoneNumber || '(435) 250-4150';
const phoneDigits = phoneNumber.replace(/\D/g, '');
const phoneHref = `tel:${phoneDigits.length === 10 ? `+1${phoneDigits}` : `+${phoneDigits}`}`;

const hoursCardTitle = site?.contactHoursCardTitle || 'Office Hours';
const hoursBody = site?.contactHoursBody || 'Monday – Friday\n9:00 AM – 5:00 PM';

const portalCardTitle = site?.contactPortalCardTitle || 'Homeowner Portal';
const portalBody = site?.contactPortalBody || 'For maintenance requests, documents, and payments.';
const portalLinkLabel = site?.contactPortalLinkLabel || 'Login to portal →';

const inputClass =
  'w-full rounded-lg border border-input bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring';
const labelClass = 'mb-1.5 block text-sm font-medium text-foreground';
---

<Layout
  title="Contact — 3c HOA Management"
  description="Contact 3c HOA Management. Call (435) 250-4150 or send us a message — we respond within one business day."
>
  <Header />

  <PageHero headline={contactHeadline} subline={contactSubline} />

  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-3">

        {/* Contact info */}
        <div class="space-y-6">
          <div class="rounded-2xl border border-border bg-card p-6">
            <p class="text-sm font-semibold text-foreground">{phoneCardTitle}</p>
            <a href={phoneHref} class="mt-1 block text-lg font-medium text-primary hover:underline">{phoneNumber}</a>
          </div>
          <div class="rounded-2xl border border-border bg-card p-6">
            <p class="text-sm font-semibold text-foreground">{hoursCardTitle}</p>
            <p class="mt-1 whitespace-pre-line text-sm text-muted-foreground">{hoursBody}</p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-6">
            <p class="text-sm font-semibold text-foreground">{portalCardTitle}</p>
            <p class="mt-1 whitespace-pre-line text-sm text-muted-foreground">{portalBody}</p>
            <a href="https://app.allhoa.com/go/3c" target="_blank" rel="noreferrer" class="mt-3 inline-flex text-sm font-medium text-primary hover:underline">
              {portalLinkLabel}
            </a>
          </div>
        </div>

        {/* Form */}
        <div class="lg:col-span-2">
          <form id="contact-form" method="POST" action="/api/contact" class="space-y-6">
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class={labelClass}>Full name</label>
                <input type="text" id="name" name="name" required class={inputClass} placeholder="Your name" />
              </div>
              <div>
                <label for="email" class={labelClass}>Email address</label>
                <input type="email" id="email" name="email" required class={inputClass} placeholder="you@example.com" />
              </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="phone" class={labelClass}>Phone <span class="text-muted-foreground">(optional)</span></label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" class={inputClass} placeholder="(435) 555-0123" />
              </div>
              <div>
                <label for="community" class={labelClass}>Community / HOA name <span class="text-muted-foreground">(optional)</span></label>
                <input type="text" id="community" name="community" class={inputClass} placeholder="Your community or HOA name" />
              </div>
            </div>

            <div>
              <label for="subject" class={labelClass}>Subject</label>
              <select id="subject" name="subject"
                class="w-full rounded-lg border border-input bg-background px-4 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
                <option value="">Select a topic…</option>
                <option value="property-management">Property management services</option>
                <option value="accounting">Accounting services</option>
                <option value="owners-rep">Owner's representative</option>
                <option value="insurance">Insurance claims assistance</option>
                <option value="homeowner">Homeowner inquiry</option>
                <option value="other">Other</option>
              </select>
            </div>

            {/* Revealed once a subject other than "Other" is chosen — every field optional */}
            <div id="property-details" hidden class="space-y-6 rounded-xl border border-border bg-secondary/40 p-6">
              <p class="text-sm font-semibold text-foreground">
                About your community <span class="font-normal text-muted-foreground">(all optional — it helps us prepare)</span>
              </p>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="duesAmount" class={labelClass}>Dues ($)</label>
                  <input type="number" id="duesAmount" name="duesAmount" min="0" step="0.01" inputmode="decimal" class={inputClass} placeholder="250" />
                </div>
                <div>
                  <label for="duesFrequency" class={labelClass}>Dues frequency</label>
                  <select id="duesFrequency" name="duesFrequency"
                    class="w-full rounded-lg border border-input bg-background px-4 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
                    <option value="">Select…</option>
                    <option value="monthly">Monthly</option>
                    <option value="quarterly">Quarterly</option>
                    <option value="yearly">Yearly</option>
                  </select>
                </div>
                <div>
                  <label for="buildings" class={labelClass}># of Buildings</label>
                  <input type="number" id="buildings" name="buildings" min="0" step="1" inputmode="numeric" class={inputClass} placeholder="3" />
                </div>
                <div>
                  <label for="units" class={labelClass}># of Units</label>
                  <input type="number" id="units" name="units" min="0" step="1" inputmode="numeric" class={inputClass} placeholder="48" />
                </div>
              </div>

              <div>
                <label for="amenities" class={labelClass}>Amenities</label>
                <textarea id="amenities" name="amenities" rows={3} class={inputClass}
                  placeholder="Pool, clubhouse, elevators, gated entry…" />
              </div>
            </div>

            <div>
              <label for="message" class={labelClass}>Message</label>
              <textarea id="message" name="message" rows={6} required class={inputClass}
                placeholder="Tell us about your community or question…" />
            </div>

            <div id="form-error" class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"></div>

            <button type="submit" id="submit-btn"
              class="w-full rounded-lg bg-nav px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-50">
              Send message
            </button>
          </form>

          <div id="success-message" class="hidden rounded-xl border border-border bg-card p-10 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-success/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h2 class="text-lg font-semibold text-foreground">{successHeading}</h2>
            <p class="mt-2 text-sm text-muted-foreground">{successBody}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMessage = document.getElementById('success-message');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const errorDiv = document.getElementById('form-error');

  // Property details appear once a subject is picked, but stay hidden for "Other".
  // Hidden fields are disabled so anything typed before switching isn't submitted,
  // while the values survive in case the visitor switches back.
  const subject = document.getElementById('subject') as HTMLSelectElement | null;
  const details = document.getElementById('property-details');

  const syncDetails = () => {
    if (!subject || !details) return;
    const show = subject.value !== '' && subject.value !== 'other';
    details.hidden = !show;
    details
      .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
      .forEach((field) => {
        field.disabled = !show;
      });
  };

  subject?.addEventListener('change', syncDetails);
  syncDetails();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';
    if (errorDiv) errorDiv.classList.add('hidden');

    try {
      const data = new FormData(form);
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(data)),
        headers: { 'Content-Type': 'application/json' },
      });
      if (res.ok) {
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      } else {
        const body = await res.json().catch(() => ({}));
        if (errorDiv) {
          errorDiv.textContent = (body as { error?: string }).error ?? 'Something went wrong. Please try again.';
          errorDiv.classList.remove('hidden');
        }
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    } catch {
      if (errorDiv) {
        errorDiv.textContent = 'Network error. Please try again.';
        errorDiv.classList.remove('hidden');
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send message';
    }
  });
</script>
