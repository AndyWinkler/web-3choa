---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const about = await reader.singletons.about.read();

const heroHeadline = about?.heroHeadline || 'About 3c HOA Management';
const heroSubline = about?.heroSubline || 'We believe every community deserves professional management built on integrity, care, and connection.';
const missionHeadline = about?.missionHeadline || 'Our Mission';
const missionBody = about?.missionBody || 'To provide transparent and effective management that puts our clients\' interests first — building communities where everyone feels at home.';
const carissaTitle = about?.carissaTitle || 'Co-Founder & CEO';
const carissaBio = about?.carissaBio || `Welcome to 3c HOA, where integrity, community, and care are at the heart of everything we do. I'm Carissa Cutler, Co-Founder and CEO, and I bring over 20 years of experience in real estate and a decade of expertise in community association management and owner representation to our company.

At 3c HOA, we believe in building strong, connected communities through transparent and effective management. Our commitment ensures that we always act in the best interests of our clients, establishing trust and long-lasting relationships.

Leveraging our connections with industry experts, we utilize the latest technology and best practices to enhance the homeowner experience. We understand the importance of clear communication and transparency, and we strive to keep our clients informed and engaged every step of the way.

We are dedicated to providing exceptional service and personalized solutions that meet the unique needs of each community we serve. Whether it's through proactive maintenance, efficient financial management, or furthering a sense of connection, our goal is to create communities where everyone feels at home.

Thank you for considering 3c HOA as your trusted partner in HOA management. We look forward to working with you.`;
const valuesHeadline = about?.valuesHeadline || 'Our Values';
const VALUE_ICONS = [
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/><path d="m18 15-2-2"/><path d="m15 18-2-2"/>',
  '<path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/>',
];
const DEFAULT_VALUES = [
  { title: 'Community', desc: 'We serve the communities we manage as if they were our own — with pride, attention, and genuine investment in every resident\'s wellbeing.' },
  { title: 'Care', desc: 'Every decision we make is guided by what\'s best for our clients. We listen, respond promptly, and follow through on every commitment.' },
  { title: 'Connect', desc: 'We bridge the gap between boards, homeowners, and vendors — creating clear channels of communication that keep communities running smoothly.' },
];
const values = VALUE_ICONS.map((icon, i) => ({
  icon,
  title: about?.values?.[i]?.title || DEFAULT_VALUES[i].title,
  desc: about?.values?.[i]?.desc || DEFAULT_VALUES[i].desc,
}));
---

<Layout
  title="About Us — 3c HOA Management"
  description="Learn about 3c HOA Management — our mission, team, and commitment to transparent, community-focused HOA management in Utah."
>
  <Header />

  {/* Hero */}
  <PageHero headline={heroHeadline} subline={heroSubline} />

  {/* Values */}
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{valuesHeadline}</h2>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {values.map((v) => (
          <div class="rounded-2xl border border-border bg-card p-8 text-center shadow-[var(--shadow-soft)]">
            <div class="mb-4 flex justify-center text-gold">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" set:html={v.icon} />
            </div>
            <h3 class="text-xl font-bold text-foreground">{v.title}</h3>
            <p class="mt-3 text-sm text-muted-foreground">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Mission */}
  <section class="bg-secondary py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{missionHeadline}</h2>
      <p class="mt-6 text-lg text-muted-foreground">{missionBody}</p>
    </div>
  </section>

  {/* Letter from Carissa */}
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-start gap-12 lg:grid-cols-[320px_1fr]">
        <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
          <img
            src="/images/carissa-cutler.jpg"
            alt="Carissa Cutler"
            class="w-72 rounded-2xl object-cover shadow-lg sm:w-80 aspect-[2/3]"
          />
          <h3 class="mt-5 text-xl font-semibold text-foreground">Carissa Cutler</h3>
          <p class="text-sm font-medium text-primary">{carissaTitle}</p>
        </div>
        <div>
          <h2 class="mb-8 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">A Letter from Our CEO</h2>
          <div class="prose prose-neutral max-w-none">
            {carissaBio.split('\n\n').map((p) => (
              <p class="mb-4 text-base leading-relaxed text-muted-foreground">{p}</p>
            ))}
            <div class="mt-10 space-y-1">
              <p class="text-base font-semibold text-foreground">Warm regards,</p>
              <p class="text-base font-semibold text-foreground">Carissa Cutler</p>
              <p class="text-sm text-muted-foreground">Co-Founder & CEO</p>
              <p class="text-sm text-muted-foreground">3c HOA Management Co</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-nav py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Let's work together</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/70">Ready to experience management built on community, care, and connection?</p>
      <a href="/contact" class="mt-8 inline-flex rounded-lg bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        Get in touch
      </a>
    </div>
  </section>

  <Footer />
</Layout>
