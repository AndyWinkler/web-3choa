---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const services = await reader.singletons.services.read();

const heroHeadline = services?.heroHeadline || 'Our Services';
const heroSubline = services?.heroSubline || 'Comprehensive HOA management solutions tailored to your community\'s unique needs.';

const pmHeadline = services?.pmHeadline || 'Property Management';
const pmBody = services?.pmBody || 'We handle the full scope of community operations so your board can focus on big-picture goals. From running meetings to enforcing compliance, we keep your community running smoothly.';
const pmBullets = services?.pmBullets?.length ? services.pmBullets : [
  'Board & homeowner meetings — scheduling, facilitation, and minutes',
  'Vendor & contract management',
  'Insurance & compliance oversight',
  'Routine and preventative maintenance coordination',
  'Homeowner communication and portal management',
];

const pmSidebarTitle = services?.pmSidebarTitle || "Who it's for";
const pmSidebarItems = services?.pmSidebarItems?.length ? services.pmSidebarItems : ['HOA Boards', 'Transitioning to Professional Management', 'Condo Associations', 'Planned Unit Developments'];

const acctHeadline = services?.acctHeadline || 'Accounting';
const acctBody = services?.acctBody || 'Sound financial management is the backbone of a healthy HOA. We provide complete accounting services with full transparency and easy access for board members.';
const acctBullets = services?.acctBullets?.length ? services.acctBullets : [
  'Annual budget preparation and management',
  'Accounts payable and receivable',
  'Assessment collection and delinquency management',
  'Bank reconciliation and financial reporting',
  'Secure document storage via the Owner\'s Portal',
];

const acctSidebarTitle = services?.acctSidebarTitle || 'What you get';
const acctSidebarItems = services?.acctSidebarItems?.length ? services.acctSidebarItems : ['Monthly financial statements', 'Annual budget reports', 'Delinquency reports', "Owner's Portal access"];

const ownersRepHeadline = services?.ownersRepHeadline || "Owner's Representative";
const ownersRepBody = services?.ownersRepBody || 'When your community undertakes capital reserve projects, you need an experienced advocate in your corner. We manage the process from start to finish.';
const ownersRepBullets = services?.ownersRepBullets?.length ? services.ownersRepBullets : [
  'Capital reserve project management',
  'Stakeholder collaboration and communication',
  'Project fund oversight and disbursement',
  'Scheduling and contractor coordination',
  'Funding assistance and reserve study support',
];

const ownersRepSidebarTitle = services?.ownersRepSidebarTitle || 'Common projects';
const ownersRepSidebarItems = services?.ownersRepSidebarItems?.length ? services.ownersRepSidebarItems : ['Roofing & exterior repairs', 'Pool & amenity renovations', 'Road & parking resurfacing', 'Common area upgrades'];

const insuranceHeadline = services?.insuranceHeadline || 'Insurance Claims Assistance';
const insuranceBody = services?.insuranceBody || 'Navigating insurance claims is complex. We guide your community through every step — from initial filing to repair coordination — so you get the outcome you deserve.';
const insuranceBullets = services?.insuranceBullets?.length ? services.insuranceBullets : [
  'Claims filing guidance and documentation',
  'Adjuster coordination and advocacy',
  'Repair vendor selection and oversight',
  'Follow-up and resolution tracking',
];

const insuranceSidebarTitle = services?.insuranceSidebarTitle || 'Claim types we assist with';
const insuranceSidebarItems = services?.insuranceSidebarItems?.length ? services.insuranceSidebarItems : ['Storm & weather damage', 'Fire & water damage', 'Liability claims', 'Property damage'];

const saHeadline = services?.saHeadline || 'Special Assessment & Loan Management';
const saBody = services?.saBody || 'We help boards navigate major capital funding hurdles smoothly and transparently.';
const saBullets = services?.saBullets?.length ? services.saBullets : [
  'HOA-specific commercial lender sourcing and underwriting facilitation',
  'Specialized assessment structuring, billing, and clear tracking',
  'Dedicated capital improvement fund separation and accounting',
  'Clear homeowner disclosure communications regarding loan terms',
  'Multi-year amortization tracking',
];

const forensicHeadline = services?.forensicHeadline || 'HOA Financial Rescue & Forensic Accounting';
const forensicBody = services?.forensicBody || 'We untangle chaotic, delayed, or neglected books to restore complete fiscal health.';
const forensicBullets = services?.forensicBullets?.length ? services.forensicBullets : [
  'Historical auditing and reconstruction of neglected financial ledgers',
  'Comprehensive bank reconciliation backlog catch-up',
  'Delinquency tracking and compliant collections recovery plans',
  'Clean baseline balancing for smooth ongoing operations',
];

const devTransitionHeadline = services?.devTransitionHeadline || 'Developer Transition & Handover Services';
const devTransitionBody = services?.devTransitionBody || "We protect the community's long-term interests during the critical handover from builder to board.";
const devTransitionBullets = services?.devTransitionBullets?.length ? services.devTransitionBullets : [
  'Independent audit of developer financial records and initial reserves',
  'Complete operational framework and accounting infrastructure setup',
  'Vendor contract review and transitional continuity planning',
  'Post-handover board training and governance onboarding',
];

const selfMgdHeadline = services?.selfMgdHeadline || 'Self-Managed HOA Support';
const selfMgdBody = services?.selfMgdBody || "Some boards want to stay in the driver's seat — and should. We work behind the scenes so your volunteers can run the community without running the back office: professional books, a payment portal homeowners actually use, and records that outlast board turnover.";
const selfMgdBullets = services?.selfMgdBullets?.length ? services.selfMgdBullets : [
  'Professional-grade financials — monthly statements, reconciliations, and reporting your board, auditors, and lenders can rely on',
  'Online payment portal for dues, assessments, and one-time payments',
  'Centralized records and institutional knowledge that survive board turnover',
  'Full homeowner transparency into finances, service requests, and community documents',
  'Clean handoffs at every board transition — the next volunteer starts with everything in place',
];

const saSidebarTitle = services?.saSidebarTitle || 'Common scenarios';
const saSidebarItems = services?.saSidebarItems?.length ? services.saSidebarItems : ['Emergency structural repairs', 'Underfunded reserve shortfalls', 'Large-scale community renovations', 'Multi-year amortization tracking'];

const forensicSidebarTitle = services?.forensicSidebarTitle || 'What you get';
const forensicSidebarItems = services?.forensicSidebarItems?.length ? services.forensicSidebarItems : ['Forensic accounting audit report', 'Restructured balance sheets', 'Formal collection roadmaps', 'Realigned reserve fund strategy'];

const devTransitionSidebarTitle = services?.devTransitionSidebarTitle || "Who it's for";
const devTransitionSidebarItems = services?.devTransitionSidebarItems?.length ? services.devTransitionSidebarItems : ['Newly constructed communities', 'Master-planned developments', 'Transitions from developer control', 'Newly formed homeowner boards'];

const selfMgdSidebarTitle = services?.selfMgdSidebarTitle || 'Add on when you need it';
const selfMgdSidebarItems = services?.selfMgdSidebarItems?.length ? services.selfMgdSidebarItems : ['Capital project management & accounting', 'HOA loan servicing', 'Budget & reserve planning', 'Annual meeting & budget season prep'];
---

<Layout
  title="Services — 3c HOA Management"
  description="3c HOA Management offers property management, HOA accounting, owner representation, and insurance claims assistance in Utah."
>
  <Header />

  {/* Hero */}
  <PageHero headline={heroHeadline} subline={heroSubline} />

  {/* Property Management */}
  <section id="property-management" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div>
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/><path d="m9 14 2.25 2.25L15.5 12"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{pmHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{pmBody}</p>
          <ul class="mt-8 space-y-3">
            {pmBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{pmSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {pmSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-border" />

  {/* Accounting */}
  <section id="accounting" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="lg:order-2">
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m7 14 4-4 3 3 5-6"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{acctHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{acctBody}</p>
          <ul class="mt-8 space-y-3">
            {acctBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:order-1 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{acctSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {acctSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-border" />

  {/* Owner's Rep */}
  <section id="owners-rep" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div>
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1Z"/><path d="M10 10V5a2 2 0 0 1 4 0v5"/><path d="M4 15v-3a8 8 0 0 1 16 0v3"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{ownersRepHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{ownersRepBody}</p>
          <ul class="mt-8 space-y-3">
            {ownersRepBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{ownersRepSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {ownersRepSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-border" />

  {/* Insurance */}
  <section id="insurance" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="lg:order-2">
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><path d="M22 12a10.06 10.06 0 0 0-20 0Z"/><path d="M12 12v8a2 2 0 0 0 4 0"/><path d="M12 2v1"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{insuranceHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{insuranceBody}</p>
          <ul class="mt-8 space-y-3">
            {insuranceBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:order-1 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{insuranceSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {insuranceSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-border" />

  {/* Special Assessment & Loan Management */}
  <section id="special-assessment" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="lg:order-2">
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><path d="M3 22h18"/><path d="M6 18v-7"/><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="m12 2 9 6H3Z"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{saHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{saBody}</p>
          <ul class="mt-8 space-y-3">
            {saBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:order-1 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{saSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {saSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-border" />

  {/* HOA Financial Rescue & Forensic Accounting */}
  <section id="forensic-accounting" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div>
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m4.93 19.07 4.24-4.24"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{forensicHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{forensicBody}</p>
          <ul class="mt-8 space-y-3">
            {forensicBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{forensicSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {forensicSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-border" />

  {/* Developer Transition & Handover */}
  <section id="developer-transition" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="lg:order-2">
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{devTransitionHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{devTransitionBody}</p>
          <ul class="mt-8 space-y-3">
            {devTransitionBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:order-1 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{devTransitionSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {devTransitionSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-border" />

  {/* Self-Managed HOA Support */}
  <section id="self-managed" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div>
          <div class="mb-4 text-gold"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10"><path d="M11 12h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 14"/><path d="m7 18 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 13 6 6"/></svg></div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{selfMgdHeadline}</h2>
          <p class="mt-4 text-lg text-muted-foreground">{selfMgdBody}</p>
          <ul class="mt-8 space-y-3">
            {selfMgdBullets.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-nav">✓</span>
                <span class="text-sm text-muted-foreground">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-secondary p-8 lg:p-12">
          <p class="text-sm font-semibold text-foreground">{selfMgdSidebarTitle}</p>
          <div class="mt-4 space-y-3">
            {selfMgdSidebarItems.map((a) => (
              <div class="rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">{a}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-nav py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Ready to get started?</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/70">Tell us about your community and we'll put together a plan that fits.</p>
      <a href="/contact" class="mt-8 inline-flex rounded-lg bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        Contact us
      </a>
    </div>
  </section>

  <Footer />
</Layout>
