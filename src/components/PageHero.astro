---
interface Props {
  headline: string;
  subline?: string;
  align?: 'center' | 'left';
}

const { headline, subline, align = 'center' } = Astro.props;
---

<section class="relative overflow-hidden py-16 sm:py-24">
  <img
    src="/images/hero-banner.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-0 bg-nav/70"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-3xl'}>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">{headline}</h1>
      {subline && <p class="mt-6 text-lg text-white/80">{subline}</p>}
      <slot />
    </div>
  </div>
</section>
