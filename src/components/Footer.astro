---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const site = await reader.singletons.site.read();
const footerTagline = site?.footerTagline || 'Providing customized HOA management services that elevate the value and efficiency of your community.';
const year = new Date().getFullYear();
---

<footer class="bg-nav text-nav-foreground">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <img src="/logos/3choa-logo-color.svg" alt="3c HOA Management" class="h-12 w-auto" />
        <p class="mt-4 max-w-sm text-sm text-white/60">
          {footerTagline}
        </p>
        <p class="mt-4 text-sm font-medium text-white/80">(435) 250-4150</p>
        <p class="text-xs text-white/50">Mon – Fri, 9:00 AM – 5:00 PM</p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white">Company</h4>
        <ul class="mt-4 space-y-2 text-sm text-white/60">
          <li><a href="/" class="transition-colors hover:text-white">Home</a></li>
          <li><a href="/services" class="transition-colors hover:text-white">Services</a></li>
          <li><a href="/about" class="transition-colors hover:text-white">About Us</a></li>
          <li><a href="/contact" class="transition-colors hover:text-white">Contact</a></li>
          <li><a href="/faq" class="transition-colors hover:text-white">FAQ</a></li>
          <li><a href="https://app.allhoa.com/go/3c" target="_blank" rel="noreferrer" class="transition-colors hover:text-white">Homeowner Portal</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white">Services</h4>
        <ul class="mt-4 space-y-2 text-sm text-white/60">
          <li><a href="/services#property-management" class="transition-colors hover:text-white">Property Management</a></li>
          <li><a href="/services#accounting" class="transition-colors hover:text-white">Accounting</a></li>
          <li><a href="/services#owners-rep" class="transition-colors hover:text-white">Owner's Representative</a></li>
          <li><a href="/services#insurance" class="transition-colors hover:text-white">Insurance Claims</a></li>
          <li><a href="/services#special-assessment" class="transition-colors hover:text-white">Special Assessment & Loan Management</a></li>
          <li><a href="/services#forensic-accounting" class="transition-colors hover:text-white">Financial Rescue & Forensic Accounting</a></li>
          <li><a href="/services#developer-transition" class="transition-colors hover:text-white">Developer Transition & Handover</a></li>
          <li><a href="/services#self-managed" class="transition-colors hover:text-white">Self-Managed HOA Support</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:items-center">
      <p>© {year} 3c HOA Management Co. All rights reserved.</p>
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/privacy-policy" class="transition-colors hover:text-white/70">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
